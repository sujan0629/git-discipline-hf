#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

if ! npx --no -- commitlint --edit "$1"; then
	echo ""
	echo "Use Conventional Commits format:"
	echo "  type(scope): short description"
	echo ""
	echo "Examples:"
	echo "  feat(auth): add login route guard"
	echo "  fix(api): handle null token response"
	echo "  chore: update eslint config"
	echo ""
	echo "Allowed types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
	exit 1
fi

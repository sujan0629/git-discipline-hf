{
  "name": "git-discipline-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Demo repository architecture for Git discipline workflows",
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test",
    "typecheck": "node scripts/typecheck-check.mjs",
    "build": "node scripts/build-check.mjs",
    "validate:branch": "node scripts/validate-branch-name.mjs"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --max-warnings=0"
    ],
    "*.{md,json,yml,yaml}": [
      "echo 'staged file validated'"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "eslint": "^9.20.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.4.3"
  }
}
